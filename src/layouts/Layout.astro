---
import "../lib/base.css";
interface Props {
  title: string;
}
import { ViewTransitions } from "astro:transitions";
import Header from "../components/Header.astro";

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="A family-friendly traditional Oktoberfest celebration on the Geelong Waterfront."
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://use.typekit.net/fbx2nko.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Source+Sans+3:ital,wght@0,200..900;1,200..900&display=swap"
      rel="stylesheet"
    />

    <style>
      body {
        visibility: hidden;
      }
    </style>
    <noscript>
      <style>
        body {
          visibility: visible;
        }
      </style>
    </noscript>
    <ViewTransitions />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body transition:name="main" transition:animate="initial">
    <Header />
    <slot />
  </body>
</html>
<style is:global>
  ::view-transition-old(main) {
    animation: slideDownOut 0.666s var(--defaultTimingIn);
  }
  ::view-transition-new(main) {
    animation: slideDownIn 0.666s var(--defaultTimingIn);
  }
</style>
<script>
  import { gsap } from "gsap";
  import { scrollTargetToCenter } from "../lib/modules";
  document.addEventListener("astro:page-load", () => {
    window.history.scrollRestoration = "manual";

    // Avoid FOUC - https://gsap.com/resources/fouc/
    // {visibility: hidden} is on the inline style tags in the <head>
    gsap.set(document.body, {
      autoAlpha: 1,
    });

    if (location.hash) {
      let url = new URL(location.href);
      scrollTargetToCenter(url);
    }
  });

  document.addEventListener("astro:after-preparation", () => {
    window.scrollTo({ left: 0, top: 0, behavior: "instant" });
  });

  document.addEventListener("astro:before-swap", (ev) => {
    //TODO: Refactor to use data attribute on current page to set animation on newDocument
    // Changing view-transition animation direction on the fly for specific routes
    const oldPage = ev.from.pathname;
    const newPage = ev.to.pathname;
    const updateStyle = (style: Node) => {
      ev.newDocument.head.appendChild(style);
    };
    const style = document.createElement("style");

    if (oldPage == "/tickets" && newPage == "/") {
      style.innerHTML = `
            ::view-transition-old(main) {
              animation: slideUpOut 0.666s var(--defaultTimingIn);
            }
            ::view-transition-new(main) {
              animation: slideUpIn 0.666s var(--defaultTimingIn);
            }
                  body {
      background: var(--sky) url(/texture.png);
    }
          `;
      updateStyle(style);
    }
  });
</script>
