---
import Layout from "../layouts/Layout.astro";
import MapSVG from "../components/MapSVG.astro";
import MapCard from "../components/MapCard.astro";
const icons = [
  {
    title: "Cunningham Pier Tent",
    id: "bt1",
    type: "beer-tents",
    gmaps: "https://maps.app.goo.gl/NPJ8815MjxppWsTr8",
    location: "Cunningham Pier",
    content:
      "Local and international beer on tap. Lunch served 1pm - 3pm & dinner 6pm - 8pm. Table bookings required for sit-down meals",
  },
  {
    title: "Transvaal Square Tent",
    id: "bt2",
    type: "beer-tents",
    gmaps: "https://maps.app.goo.gl/WV7p3UE2Tr7AWf7b7",
    location: "Cunningham Pier",
    content:
      "Local beers from Bellarine Peninsula and Otways breweries on tap. German sausages available all day.",
  },
  {
    title: "Eastern Beach Reserve Tent",
    id: "bt3",
    type: "beer-tents",
    gmaps: "https://maps.app.goo.gl/Hc2QiC9oWqdz3awY7",
    location: "Cunningham Pier",
    content:
      "Local and international beer on tap. Lunch served 1pm - 3pm & dinner 6pm - 8pm. Table bookings required for sit-down meals",
  },
  {
    title: "Cunningham Pier Market",
    id: "stall1",
    type: "stalls",
    gmaps: "https://maps.app.goo.gl/A3kjCRVHGLfDy5yFA",
    location: "Cunningham Pier",
    content:
      "Food trucks and stalls, plus live entertainment and rides from 10am til late.",
  },
  {
    title: "Steampacket Gardens Market",
    id: "stall2",
    type: "stalls",
    gmaps: "https://maps.app.goo.gl/Lnt2pGcBZJeVBM3Z9",
    location: "Cunningham Pier",
    content:
      "Food stalls from some of the best bakeries in Victoria. Enjoy a fresh brezeln and live music on the main stage. Open 10am til 5pm.",
  },
  {
    title: "Eastern Beach Reserve Market",
    id: "stall3",
    type: "stalls",
    gmaps: "https://maps.app.goo.gl/ME7qaa68TrPsjmqH9",
    location: "Cunningham Pier",
    content:
      "Wide variety of food trucks and stalls, with everything from coffee and cake to Polish sausages",
  },
  {
    title: "Steampacket Gardens Stage",
    id: "stage1",
    type: "stage",
    gmaps: "https://maps.app.goo.gl/ofVzUaC31XBPUSDVA",
    location: "Cunningham Pier",
    content:
      "Main stage with live music and performances all day, 10am til late.",
  },
  {
    title: "Cunningham Pier Toilets",
    id: "toilet1",
    type: "toilets",
    gmaps: "https://maps.app.goo.gl/4WEzxdckhMxFzixf8",
    location: "Cunningham Pier",
    content:
      "Public toilets with accessible bathrooms and baby change facilities",
  },
  {
    title: "Eastern Beach Reserve Toilets",
    id: "toilet2",
    type: "toilets",
    gmaps: "hhttps://maps.app.goo.gl/N7bHFhaxgz2UuWFz8",
    location: "Cunningham Pier",
    content:
      "Portable toilets only. Accessible toilets and baby change facilities are located at Transvaal Square and Cunningham Pier",
  },
  {
    title: "Transvaal Square Toilets",
    id: "toilet3",
    type: "toilets",
    gmaps: "https://maps.app.goo.gl/xWLig1iB5HWYsZU6A",
    location: "Cunningham Pier",
    content:
      "Public toilets with accessible bathrooms and baby change facilities",
  },
  {
    title: "Geelong Station",
    id: "train1",
    type: "trains",
    gmaps: "https://maps.app.goo.gl/NPJ8815MjxppWsTr8",
    location: "Cunningham Pier",
    content:
      "Follow Brougham Street to Geelong Station for access to V-line trains and local buses",
  },
  {
    title: "Smythe St Carpark",
    id: "parking1",
    type: "parking",
    gmaps: "https://maps.app.goo.gl/DCvFHwmoWU396Svr6",
    location: "Cunningham Pier",
    content:
      "300 parking spaces, $15 all day parking. Enter Smythe Street via Cavendish Street",
  },
];
---

<Layout title="Map - Oktoberfest Geelong">
  <!-- <main id="main" transition:name="main" transition:animate={downOutUpIn}> -->
  <main id="main">
    <div class="content-area">
      <section class="section-wrapper map-wrapper">
        <!-- <h2>Event map</h2> -->
        <menu class="map-key">
          <li data-name="Beer Tents">
            <a href="#beer-tents" title="Beer Tents"
              ><svg viewBox="0 0 60 60" width="60" height="60"
                ><use href="#beer-tent-icon"></use></svg
              ><span>Beer Tents</span></a
            >
          </li>
          <li data-name="Food stalls">
            <a href="#stalls" title="Food Stalls">
              <svg viewBox="0 0 60 60" width="60" height="60"
                ><use href="#stall-icon"></use></svg
              >
              <span>Food Stalls</span>
            </a>
          </li>
          <li data-name="Main Stage">
            <a href="#stage" title="Main Stage">
              <svg viewBox="0 0 60 60" width="60" height="60"
                ><use href="#stage-icon"></use></svg
              ><span>Main Stage</span></a
            >
          </li>
          <li data-name="Parking">
            <a href="#parking" title="Parking">
              <svg viewBox="0 0 60 60" width="60" height="60"
                ><use href="#parking-icon"></use></svg
              ><span>Parking</span></a
            >
          </li>
          <li data-name="Toilets">
            <a href="#toilets" title="Toilets">
              <svg viewBox="0 0 60 60" width="60" height="60"
                ><use href="#toilet-icon"></use></svg
              ><span>Toilets</span></a
            >
          </li>
          <li data-name="Public Transport">
            <a href="#trains" title="Public Transport">
              <svg viewBox="0 0 60 60" width="60" height="60"
                ><use href="#trains-icon"></use></svg
              ><span>Public Transport</span></a
            >
          </li>
        </menu>
        <header class="map-header">
          <h1>Festival map</h1>
        </header>
        <section class="map-cards">
          {
            icons.map((card) => (
              <MapCard
                name={card.title}
                id={card.id}
                type={card.type}
                gmaps={card.gmaps}
                location={card.location}
                content={card.content}
              />
            ))
          }
        </section>

        <div id="map">
          <MapSVG />
        </div>
      </section>
    </div>
  </main>

  <script>
    import gsap from "gsap";
    import {
      defaultTimingIn,
      defaultTimingOut,
      mapTimeline,
    } from "../lib/timelines";
    document.addEventListener("astro:page-load", () => {
      const iconsGroup = document.querySelector('#map [data-name="Icons"]');
      const icons = iconsGroup?.querySelectorAll("[data-icon]");
      const keyItems: NodeListOf<HTMLAnchorElement> =
        document.querySelectorAll(".map-key a");
      const loadTimeline = gsap.timeline({ paused: false, repeat: 0 });
      const mapCards = gsap.utils.toArray(".map-card");
      const hash = location.hash;

      // Hide the map cards initially
      loadTimeline.set(mapCards, { autoAlpha: 0 });
      // Animate map in
      loadTimeline.add(mapTimeline(), "start");
      focusGroup(null, hash);
      // Register click handlers for map controls
      keyItems && registerMapKeyItems(keyItems);
      icons && registerIcons(icons);
    });

    // Set click handlers for map keys
    function registerMapKeyItems(keys: NodeListOf<HTMLAnchorElement>) {
      keys.forEach((key) => {
        key.addEventListener("click", (ev) => {
          ev.preventDefault();
          focusGroup(key, null);
        });
      });
    }

    // Set click handlers for map icons
    function registerIcons(icons: NodeList) {
      icons?.forEach((icon) => {
        icon.addEventListener("click", (ev) => {
          ev.preventDefault();
          // Check if there is an active icon
          if (icon instanceof SVGAElement) {
            focusIcon(icon);
          }
        });
      });
    }

    // Set the current target group from the map key or url fragment (eg. '#target')
    function focusGroup(key: HTMLAnchorElement | null, hash: string | null) {
      const anchor = key ? key.getAttribute("href") : hash;
      // select the icon group using the url fragment
      if (anchor) {
        const target: SVGAElement | null = document.querySelector(`${anchor}`);
        if (target && target.dataset.icongroup === undefined) {
          // If the target is a single icon, focus it
          focusIcon(target);
        } else if (target) {
          // focus the first icon in the group
          const firstIcon: SVGAElement | null =
            target.querySelector("[data-icon]");
          firstIcon && focusIcon(firstIcon);
          // set the active state for the icon group
          target.dataset.activeGroup = "true";
        }
      } else {
      }
    }

    // Unset current target group
    function unfocusGroup(group: SVGAElement) {
      group.dataset.activeGroup = "false";
    }

    // Sets the current active icon, unfocus current icon and group
    async function focusIcon(icon: SVGAElement) {
      // Check for current group selection
      const currentGroup: SVGAElement | null = document.querySelector(
        '[data-active-group="true"]'
      );
      currentGroup && unfocusGroup(currentGroup);
      // Check if there is an active icon
      const currentIcon: SVGAElement | null = document.querySelector(
        '[data-icon][data-active="true"]'
      );
      // Remove data-active from active icon
      currentIcon && unfocusIcon(currentIcon);
      // Set data-active on new icon
      icon.dataset.active = "true";
      showCardFor(icon);
    }

    // Unsets the current active icon
    function unfocusIcon(icon: SVGElement) {
      icon.dataset.active = "false";
    }

    // Shows the details card for a given map icon
    function showCardFor(icon: SVGElement) {
      const name = icon.dataset.name;
      const newCard = document.querySelector(`.card[data-name="${name}"]`);
      newCard && setCard(newCard);
    }

    // Handles animation for card swapping
    function setCard(card: Element) {
      const oldCard = document.querySelector('.card[aria-current="location"]');
      let swapCardTl = gsap.timeline();
      // Swap them with gsap
      if (oldCard) {
        swapCardTl.to(
          oldCard,
          {
            autoAlpha: 0,
            x: 20,
            duration: 0.1,
            ease: defaultTimingOut,
            onComplete: () => {
              oldCard.ariaCurrent = "false";
            },
          },
          "card-out"
        );
      }
      if (card) {
        swapCardTl.fromTo(
          card,
          {
            autoAlpha: 0,
            x: -30,
          },
          {
            autoAlpha: 1,
            x: 0,
            duration: 0.15,
            ease: defaultTimingIn,
            onStart: () => {
              card.ariaCurrent = "location";
            },
          },
          "card-in"
        );
      }
    }
  </script>
  <style is:global>
    ::view-transition-old(main) {
      animation: slideUpOut 0.666s var(--defaultTimingIn);
    }
    ::view-transition-new(main) {
      animation: slideUpIn 0.666s var(--defaultTimingIn);
    }
    #main {
      padding: 0;
      background: linear-gradient(
          in oklab,
          var(--sand) 0%,
          var(--offWhite) 100%
        ),
        url(/texture-2.png);
      background-blend-mode: hard-light;
      min-height: calc(100vh - 100px);
    }
    .content-area {
      grid-template-columns: minmax(min-content, max-content) minmax(
          min-content,
          1fr
        );
    }
    .map-wrapper {
      grid-template-rows: min-content 1fr min-content;
      margin: 1rem 0;
      border-top: var(--borderLight);
    }
    .map-header {
      display: flex;
      padding: 1rem;
      grid-column: 1;
      grid-row: 1;
      align-items: center;
      border-bottom: var(--borderLight);
      border-right: var(--borderLight);

      & h1 {
        margin: 0;
        font-size: 1.25rem;
        color: var(--red);
      }
    }
    #map {
      display: grid;
      justify-items: end;
      grid-row: 2 / -1;
      grid-column: 1 / -1;
      overflow: hidden;
      margin: 1rem;

      & svg {
        height: auto;
        width: auto;
        max-width: 650px;
        transition: transform 0.25s var(--defaultTimingIn);

        & .icon-outline {
          fill: inherit;
        }
      }
    }
    #map [data-icon] {
      cursor: pointer;
      transition: transform 0.25s var(--defaultTimingIn);
      will-change: transform;
      transform-box: border-box;
      transform-origin: center;
      fill: var(--white);
    }
    /* Apply highlight styles to map icons on hover, focus-visible or when the  parent group is the current target as set by the url fragment (allows linking to icon groups and highlighting when interacting with map key) */

    #map [data-active-group="true"] [data-icon] {
      transform: scale(1.3);
      & use {
        fill: var(--brightblueTint50);
      }
    }
    #map [data-icon]:is(:hover, :focus-visible, [data-active="true"]) {
      transform: scale(1.3);
      & use {
        fill: var(--brightblue);
      }
    }
    .map-cards {
      position: sticky;
      inset-block-end: 0;
      display: grid;
      grid-column: 1 / -1;
      grid-row: 3;
      opacity: 0;
      background: radial-gradient(
          circle at 0 0 in oklab,
          var(--offWhite) 0%,
          var(--offWhite) 100%
        ),
        url(/texture-2.png);
      background-blend-mode: hard-light;
      transition: opacity 0.25s var(--defaultTimingIn) 0.25s;
      z-index: 20;
      overflow: clip;
      &:has([aria-current="location"]) {
        opacity: 1;
        transition-delay: 0s;
      }

      .map-card {
        grid-row: 1;
        grid-column: 1 / -1;
        text-wrap: balance;
      }
    }
    .map-key {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: 1fr 1fr;
      grid-row: 1;
      grid-column: 2 / -1;
      list-style: none;
      column-gap: 1em;
      row-gap: 0.5em;
      margin: 0;
      padding: 1rem;
      border-bottom: var(--borderLight);

      & li {
        display: contents;
      }
      & li a {
        display: grid;
        grid-template-columns: 30px 1fr;
        align-items: center;
        gap: 0.5em;
        fill: var(--white);
        font-size: 0.75rem;
        color: var(--bodyTextColour);
        &:hover,
        &:focus-visible {
          fill: var(--brightblue);
        }
        & span {
        }
        & svg {
          max-width: 100%;
          height: auto;
        }
      }
    }
    @media (min-width: 750px) {
      #map {
        margin: 2rem;
      }
      .map-key {
        grid-template-columns: repeat(6, 1fr);
        grid-template-rows: 1fr;
        & li {
        }
      }
    }
    @media (min-width: 900px) {
      .content-area {
        grid-template-columns: 1fr 20em;
      }
      .map-key {
        position: sticky;
        grid-row: 3;
        grid-column: 1 / -1;
        inset-block-end: 0;
        background: radial-gradient(
            circle at 0 0 in oklab,
            var(--offWhite) 0%,
            var(--offWhite) 100%
          ),
          url(/texture-2.png);
        border-bottom: none;
        border-top: var(--borderLight);
        z-index: 50;
      }
      #map {
        grid-row: 1 / -1;
        justify-items: end;
        grid-column: 1;
      }
      /* .map-wrapper {
        border-top: var(--borderLight);
      } */
      .map-header {
        grid-column: 2;
        grid-row: 1;
        padding: 1rem 2rem;
        border-left: var(--borderLight);
        & h1 {
          font-size: 2rem;
        }
      }
      .map-info {
        padding: 0 2rem;
        display: grid;
        grid-auto-flow: column;
      }
      .map-cards {
        opacity: 1;
        grid-row: 2 / -1;
        grid-column: 2;
        position: relative;
        border-left: var(--borderLight);
        /* border-top: var(--borderDotted); */
        background: transparent;
      }
    }
    @media (min-width: 1100px) {
      .map-key {
        li a {
          grid-template-columns: 3em 1fr;
        }
      }
      .map-header {
        & h1 {
          font-size: 2.25rem;
        }
      }
      #map [data-icon] {
        transform: rotateZ(90deg);
      }
      #map [data-icon]:is(:hover, :focus-visible, [data-active="true"]),
      #map [data-active-group="true"] [data-icon] {
        transform: rotateZ(90deg) scale(1.3);
      }
      [data-flip="true"] {
        transform: rotate(180deg);
        transform-origin: center;
        transform-box: border-box;
      }
      #map {
        /* padding: 0 4rem 4rem 0; */
        max-height: 650px;
        justify-items: start;
        & svg {
          transform: rotateZ(-90deg) translateX(-100%);
          transform-origin: top left;
        }
      }
    }
    @media (min-width: 1400px) {
      .content-area {
        grid-template-columns: 1fr 24em;
      }
      .map-header {
        & h1 {
          font-size: 2.5rem;
        }
      }
      #map {
        max-height: 750px;
        & svg {
          max-width: 750px;
        }
      }
    }
    @media (min-width: 1600px) {
      .content-area {
        grid-template-columns: 1fr 28em;
      }
    }
  </style>
</Layout>
