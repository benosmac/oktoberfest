---

<Layout title="Map - Oktoberfest Geelong">
  <header>
    <div class="logo">
      <a href="/" title="Oktoberfest Geelong Homepage">
        <Logo />
      </a>
    </div>
    <Nav />
  </header>
  <main id="main">
    <div class="content-area">
      <section class="section-wrapper">
        <div class="map-info">
          <h2>Event map</h2>
          <menu class="map-key">
            <li data-name="Beer Tents">
              <a href="#beer-tents" title="Beer Tents"
                ><svg viewBox="0 0 60 60" width="60" height="60"
                  ><use href="#beer-tent-icon"></use></svg
                ><span>Beer Tents</span></a
              >
            </li>
            <li data-name="Food stalls">
              <a href="#stalls" title="Food Stalls">
                <svg viewBox="0 0 60 60" width="60" height="60"
                  ><use href="#stall-icon"></use></svg
                >
                <span>Food Stalls</span>
              </a>
            </li>
            <li data-name="Main Stage">
              <a href="#stage" title="Main Stage">
                <svg viewBox="0 0 60 60" width="60" height="60"
                  ><use href="#stage-icon"></use></svg
                ><span>Main Stage</span></a
              >
            </li>
            <li data-name="Parking">
              <a href="#parking" title="Parking">
                <svg viewBox="0 0 60 60" width="60" height="60"
                  ><use href="#parking-icon"></use></svg
                ><span>Parking</span></a
              >
            </li>
            <li data-name="Toilets">
              <a href="#toilets" title="Toilets">
                <svg viewBox="0 0 60 60" width="60" height="60"
                  ><use href="#toilet-icon"></use></svg
                ><span>Toilets</span></a
              >
            </li>
            <li data-name="Public Transport">
              <a href="#trains" title="Public Transport">
                <svg viewBox="0 0 60 60" width="60" height="60"
                  ><use href="#trains-icon"></use></svg
                ><span>Public Transport</span></a
              >
            </li>
          </menu>
          <section class="map-cards">
            {
              icons.map((card) => (
                <MapCard
                  name={card.title}
                  id={card.id}
                  type={card.type}
                  gmaps={card.gmaps}
                  location={card.location}
                  content={card.content}
                />
              ))
            }
          </section>
        </div>
        <div id="map">
          <MapSVG />
        </div>
      </section>
    </div>
  </main>

  <script>
    import gsap from "gsap";
    import {
      defaultTimingIn,
      defaultTimingOut,
      mapTimeline,
    } from "../lib/timelines";
    document.addEventListener("astro:page-load", () => {
      const iconsGroup = document.querySelector('#map [data-name="Icons"]');
      const icons = iconsGroup?.querySelectorAll("[data-icon]");
      const keyItems: NodeListOf<HTMLAnchorElement> =
        document.querySelectorAll(".map-key a");
      const loadTimeline = gsap.timeline({ paused: false, repeat: 0 });
      const mapCards = gsap.utils.toArray(".map-card");
      const hash = location.hash;
      console.log(hash);

      // Hide the map cards initially
      loadTimeline.set(mapCards, { autoAlpha: 0 });
      // Animate map in
      loadTimeline.add(mapTimeline(), "start");
      focusGroup(null, hash);
      // Register click handlers for map controls
      keyItems && registerMapKeyItems(keyItems);
      icons && registerIcons(icons);
    });

    // function setTargetGroupFromHash(hash: string) {
    //   const targetGroup: HTMLAnchorElement | null =
    //     document.querySelector(hash);
    //   console.log(targetGroup);
    //   targetGroup && focusGroup(null, targetGroup);
    // }
    // Set click handlers for map keys
    function registerMapKeyItems(keys: NodeListOf<HTMLAnchorElement>) {
      keys.forEach((key) => {
        key.addEventListener("click", (ev) => {
          ev.preventDefault();
          focusGroup(key, null);
        });
      });
    }

    // Set click handlers for map icons
    function registerIcons(icons: NodeList) {
      icons?.forEach((icon) => {
        icon.addEventListener("click", (ev) => {
          ev.preventDefault();
          // Check if there is an active icon
          if (icon instanceof SVGElement) {
            focusIcon(icon);
          }
        });
      });
    }

    // Set the current target group from the map key or url fragment (eg. '#target')
    function focusGroup(key: HTMLAnchorElement | null, hash: string | null) {
      const anchor = key ? key.getAttribute("href") : hash;
      // select the icon group using the url fragment
      if (anchor) {
        const group: SVGAElement | null = document.querySelector(`${anchor}`);

        if (group) {
          // select the first icon in the group and make it the active icon
          const firstIcon: SVGAElement | null =
            group.querySelector("[data-icon]");
          firstIcon && focusIcon(firstIcon);
          // set the active state for the icon group
          group.dataset.activeGroup = "true";
        }
      }
    }

    // Unset current target group
    function unfocusGroup(group: SVGAElement) {
      group.dataset.activeGroup = "false";
    }

    // Sets the current active icon, unfocus current icon and group
    function focusIcon(icon: SVGElement) {
      // Check for current group selection
      const currentGroup: SVGAElement | null = document.querySelector(
        '[data-active-group="true"]'
      );
      currentGroup && unfocusGroup(currentGroup);
      // Check if there is an active icon
      const currentIcon: SVGAElement | null = document.querySelector(
        '[data-icon][data-active="true"]'
      );
      // Remove data-active from active icon
      currentIcon && unfocusIcon(currentIcon);
      // Set data-active on new icon
      icon.dataset.active = "true";
      showCardFor(icon);
    }

    // Unsets the current active icon
    function unfocusIcon(icon: SVGElement) {
      icon.dataset.active = "false";
    }

    // Shows the details card for a given map icon
    function showCardFor(icon: SVGElement) {
      const name = icon.dataset.name;
      const newCard = document.querySelector(`.card[data-name="${name}"]`);
      newCard && setCard(newCard);
    }

    // Handles animation for card swapping
    function setCard(card: Element) {
      const oldCard = document.querySelector('.card[aria-current="location"]');
      let swapCardTl = gsap.timeline();
      // Swap them with gsap
      if (oldCard) {
        swapCardTl.to(
          oldCard,
          {
            autoAlpha: 0,
            x: 20,
            duration: 0.1,
            ease: defaultTimingOut,
            onComplete: () => {
              oldCard.ariaCurrent = "false";
            },
          },
          "card-out"
        );
      }
      if (card) {
        swapCardTl.fromTo(
          card,
          {
            autoAlpha: 0,
            x: -30,
          },
          {
            autoAlpha: 1,
            x: 0,
            duration: 0.15,
            ease: defaultTimingIn,
            onStart: () => {
              card.ariaCurrent = "location";
            },
          },
          "card-in"
        );
      }
    }
  </script>
  <style is:global>
    body {
      background: var(--sky) url(/texture.png);
      /* background: linear-gradient(
          180deg in oklab,
          var(--darkSand) 0%,
          var(--sand) 20%,
          var(--sand) 50%
        ),
        url(/texture.png); */
    }
    #main {
      padding: 0;
    }
    .content-area {
      border-radius: 1rem 1rem 0 0;
      border-radius: 1em;
      grid-template-columns: 1fr 20em;
      /* padding: 2rem; */
    }
    #map {
      display: grid;
      justify-items: start;
      grid-row: 2 / 3;
      grid-column: 1 / -1;
      overflow: hidden;
      background-image: linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0),
        var(--lightSand) 50%
      );

      & svg {
        height: auto;
        width: auto;
        max-width: 620px;
        transition: transform 0.25s var(--defaultTimingIn);

        & .icon-outline {
          fill: inherit;
        }
      }
    }
    #map [data-icon] {
      cursor: pointer;
      transition: transform 0.25s var(--defaultTimingIn);
      will-change: transform;
      transform-box: border-box;
      transform-origin: center;
      fill: var(--brightblueTint70);
    }
    /* Apply highlight styles to map icons on hover, focus-visible or when the  parent group is the current target as set by the url fragment (allows linking to icon groups and highlighting when interacting with map key) */

    #map [data-active-group="true"] [data-icon] {
      transform: scale(1.1);
      & use {
        fill: var(--brightblueTint50);
      }
    }
    #map [data-icon]:is(:hover, :focus-visible, [data-active="true"]) {
      transform: scale(1.1);
      & use {
        fill: var(--brightblue);
      }
    }
    .map-info {
      grid-column: 1 / -1;
      grid-row: 1;
      z-index: 20;
      padding: 2rem 2rem 0 2rem;
      & h2 {
        color: var(--red);
      }
    }
    .map-cards,
    .map-key {
      margin: 0;
      padding: 1rem 0;
    }
    .map-cards {
      position: fixed;
      inset: auto 0 0 0;
      background: var(--white);
      padding: 2rem;
      display: grid;
      align-items: start;
      box-shadow: 0 0 0.5rem rgba(0, 0, 0, 0.1);

      .map-card {
        grid-row: 1;
        grid-column: 1;
        align-content: start;
        align-self: start;
        border: none;
        padding: 0;
      }
    }
    .map-key {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: 1fr 1fr;
      list-style: none;
      column-gap: 1em;
      row-gap: 0.5em;
      margin: 1rem;
      padding: 0.5rem 1rem;
      border-radius: 0.5em;
      /* box-shadow: 0px 0.75rem 0.75rem rgba(0, 0, 0, 0.1); */
      /* background: var(--sand); */
      /* border: var(--borderDottedLight); */
      & li {
        display: contents;
      }
      & li a {
        display: grid;
        grid-template-columns: 28px 1fr;
        align-items: center;
        gap: 0.5em;
        fill: #8ccad0;
        font-size: 0.75rem;
        & span {
        }
        & svg {
          max-width: 100%;
          height: auto;
        }
      }
    }
    @media (min-width: 750px) {
      .map-key {
        grid-template-columns: repeat(6, 1fr);
        grid-template-rows: 1fr;
        & li {
        }
      }
    }
    @media (min-width: 900px) {
      #map {
        grid-row: 2;
        padding: 0 0 0 2rem;
      }
      .map-info {
        /* grid-column: 2; */
        /* align-self: start; */
        /* margin: 1rem; */
        /* border-radius: 0.5em; */
        /* box-shadow: 0px 0.75rem 0.75rem rgba(0, 0, 0, 0.1); */
        /* background: var(--sand); */
        padding: 0 2rem;
        display: grid;
        /* grid-template-rows: min-content */
        grid-auto-flow: column;
      }
      .map-cards {
        /* position: relative; */
        /* padding: 2rem 0; */
        /* background: transparent; */
        opacity: 0;
        border-radius: 0.5rem 0 0 0;
        inset: auto 0 0 auto;
        max-width: 20em;
        /* Delay transition when animating out to avoid flash between cards */
        transition: opacity 0.25s var(--defaultTimingIn) 0.25s;
        &:has([aria-current="location"]) {
          opacity: 1;
          /* Remove delay for animating card in */
          transition-delay: 0s;
        }
      }
      .map-key {
        /* grid-template-columns: 1fr 1fr; */
        /* grid-auto-flow: initial; */
        padding: 0.5rem 1rem;
        /* border-bottom: var(--borderLight); */
        margin: 0;
        /* border-radius: .5rem; */
        /* box-shadow: none; */
        /* background: transparent; */
        /* max-width: 700px; */
        justify-self: end;
      }
    }
    @media (min-width: 1100px) {
      #map [data-icon] {
        transform: rotateZ(90deg);
      }
      #map [data-icon]:is(:hover, :focus-visible, [data-active="true"]),
      #map [data-active-group="true"] [data-icon] {
        transform: rotateZ(90deg) scale(1.1);
        box-shadow: 0px 0px 1rem rgba(0, 0, 0, 0.25);
      }
      [data-flip="true"] {
        transform: rotate(180deg);
        transform-origin: center;
        transform-box: border-box;
      }
      /* .map-cards {
        grid-row: 2;
      } */
      #map {
        padding: 0 4rem 4rem 0;
        max-height: 620px;
        min-height: 100vh;
        justify-items: start;
        & svg {
          max-height: calc(100dvw - 2rem);
          transform: rotateZ(-90deg) translateX(-100%);
          transform-origin: top left;
        }
      }
    }
  </style>
</Layout>
