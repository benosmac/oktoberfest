---
import Layout from "../layouts/Layout.astro";
import BackgroundScene from "../components/BackgroundScene.astro";
import TimeCard from "../components/TimeCard.astro";
import ContentHeading from "../components/ContentHeading.astro";
import { Icon } from "astro-icon/components";

const timeCardData = [
  {
    title: "Zweites Frühstück",
    body: "Food stalls and entertainment on Cunningham Pier. Come and enjoy a fresh brezeln on the beach.",
    def: "/ˈtsvaitəs ˈfʁyːˌʃtʏk/ Second breakfast",
    href: "/map#cunningham-pier-stalls",
    time: "10am",
  },
  {
    title: "Frühschoppen",
    body: '"O\'zapft is!" will be called at midday. From Amber Ale to Weizenbock, you will find a huge variety of beer on tap in the 3 Beer Tents along the waterfront.',
    def: "(noun) /ˈfryːʃɔpən/ Morning drink",
    href: "/map#beer-tents",
    time: "12pm",
  },
  {
    title: "Kaffee und Kuchen",
    body: "Sit down and enjoy delicious cakes and coffee. You will find stalls by acclaimed German bakeries Hootsen's and Bretzel Biz in Steampacket Gardens",
    def: "/ˈkafe ʌnd ˈkuːxn̩/ Cofee and cake",
    href: "/map#stalls",
    time: "3pm",
  },
  {
    title: "Schuhplattler",
    body: "Live performances on the main stage, featuring traditional folk dancing and music.",
    def: "(noun) /ˈshüˌplätlə(r)/ a Bavarian courtship dance",
    href: "/map#stage",
    time: "5pm",
  },

  {
    title: "Abendessen",
    body: "Explore food stalls along the waterfront, or sit for a traditional Oktoberfest meal at one of the 3 Beer Tents.",
    def: "(noun) /ˈaːbənt|ɛsən/ Evening meal",
    href: "#map",
    time: "7pm",
  },
];
---

<Layout title="Oktoberfest Geelong">
  <main id="main">
    <div class="content-area">
      <section class="hero">
        <h2 class="hero-headline">
          <span>Beer,</span>
          <span>Bratwurst,</span>
          <span>Beach.</span>
        </h2>
        <div class="details">
          <span>
            <h3>Saturday October 4</h3>
            <p>Cunningham Pier, Geelong Waterfront</p>
          </span>
          <span class="details-btns">
            <a class="btn btn--blue btn--outline" href=" map">
              <Icon name="icon-map" />Map</a
            >
            <a class="btn" href="/tickets">
              <Icon name="icon-ticket" /> Tickets</a
            >
          </span>
        </div>
      </section>
      <section class="section-wrapper">
        <ContentHeading title="Things to do" />
        <ul class="time-cards-list" id="things-to-do">
          {
            timeCardData.map((card) => (
              <TimeCard
                title={card.title}
                body={card.body}
                def={card.def}
                href={card.href}
                time={card.time}
              />
            ))
          }
        </ul>
      </section>

      <section class="section-wrapper">
        <ContentHeading title="Info" />
        <ul
          class="info-cards-wrapper"
          id="info"
          data-scrolltrigger="card"
          data-time="end"
        >
          <li class="info-card">
            <h4 class="card-title">Getting here</h4>
            <p>
              Getting to Oktoberfest Geelong is easy, whether you're driving or
              coming by public transport.
            </p>
            <a class="btn btn--small" href="/map/#parking">Parking</a>
            <a class="btn btn--small" href="/map/#transport">Public Transport</a
            >
          </li>
          <li class="info-card">
            <h4 class="card-title">Tickets</h4>
            <p>
              Oktoberfest Geelong is a free event for the whole family, but we
              do have a capacity limit so pre-booked tickets are required for
              every visitor.
            </p>
            <a class="btn btn--small" title="Book tickets" href="/tickets"
              >Book now</a
            >
          </li>
        </ul>
      </section>
    </div>
    <BackgroundScene />
  </main>

  <script>
    import {
      panInTimeline,
      logoTimeline,
      showHeaderTimeline,
      heroDetailsTimeline,
      setCardTriggers,
      birdTimeline,
      boatTimeline,
      wheelTimeline,
      wavesTimeline,
    } from "../lib/timelines.ts";
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);
    // COMPOSE HOMEPADE LOAD TIMELINE
    let intialLoadTimeline = gsap.timeline({ repeat: 0, paused: false });

    // Runs on full page refresh
    window.addEventListener("DOMContentLoaded", () => {
      intialLoadTimeline
        .add(panInTimeline(), "panIn")
        .add("content", ">+0.25")
        .add(showHeaderTimeline(), "content")
        .add(heroDetailsTimeline(), "content");
    });
    // Runs after every Astro router navigate event
    document.addEventListener("astro:page-load", () => {
      // console.log(location.pathname);

      if (location.pathname == "/") {
        intialLoadTimeline
          .add(wavesTimeline(), "content")
          .add(birdTimeline(), "content")
          .add(boatTimeline(), "content")
          .add(wheelTimeline(), "content");

        // SETUP CARD TRIGGERS
        const cards = document.querySelectorAll('[data-scrolltrigger="card"]');
        setCardTriggers(cards);

        // FADE OUT HERO ON SCROLL
        const hero = document.querySelector(".hero");
        if (hero) {
          let heroOutTL = gsap.timeline({
            scrollTrigger: {
              trigger: hero,
              start: "top 150",
              end: "bottom center",
              scrub: 0.1,
              pin: false,
            },
          });
          heroOutTL.to(
            hero,
            {
              opacity: 0,
            },
            "out"
          );
        }

        // STATUE SHADOWS
        const statuesShadows = document.querySelector(".statues-shadows");
        const timecardWrapper = document.querySelector("#things-to-do");
        if (statuesShadows && timecardWrapper) {
          gsap.to(statuesShadows, {
            skewX: "-70deg",
            ease: "none",
            scrollTrigger: {
              trigger: timecardWrapper,
              start: "top bottom",
              end: "bottom center",
              scrub: 0.5,
              markers: false,
            },
          });
        }

        const duskTrigger = document.querySelector('[data-time="5pm"]');
        const nightTrigger = document.querySelector('[data-time="7pm"]');
        const lateNightTrigger = document.querySelector('[data-time="end"]');

        function setNightColours(self: ScrollTrigger) {
          if (!self.isActive) {
            document.body.classList.remove("night");
            return;
          }
          document.body.classList.add("night");
        }
        function setDuskColours(self: ScrollTrigger) {
          if (!self.isActive) {
            document.body.classList.remove("dusk");
            return;
          }
          document.body.classList.add("dusk");
        }
        function setLateNightColours(self: ScrollTrigger) {
          if (!self.isActive) {
            document.body.classList.remove("late-night");
            return;
          }
          document.body.classList.add("late-night");
        }
        ScrollTrigger.getById("duskTrigger")?.kill();
        ScrollTrigger.getById("nightTrigger")?.kill();
        ScrollTrigger.getById("lateNightTrigger")?.kill();

        if (duskTrigger) {
          ScrollTrigger.create({
            trigger: duskTrigger,
            endTrigger: nightTrigger,
            start: "top center",
            end: "bottom center",
            id: "duskTrigger",
            onToggle: setDuskColours,
          });
        }
        if (nightTrigger) {
          ScrollTrigger.create({
            trigger: nightTrigger,
            endTrigger: lateNightTrigger,
            start: "top center",
            end: "bottom -10",
            id: "nightTrigger",
            onToggle: setNightColours,
          });
        }
        if (lateNightTrigger) {
          ScrollTrigger.create({
            trigger: lateNightTrigger,
            endTrigger: document.body,
            start: "top center",
            end: "bottom -10",
            id: "lateNightTrigger",
            onToggle: setLateNightColours,
          });
        }
      }
    }); //end astro:page-load
  </script>
  <style is:global>
    ::view-transition-old(main) {
      animation: slideDownOut 0.666s var(--defaultTimingIn);
    }
    ::view-transition-new(main) {
      animation: slideDownIn 0.666s var(--defaultTimingIn);
    }
    .info-cards-wrapper {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      grid-template-columns: subgrid;
      gap: 4rem;
      @media (min-width: 750px) {
        grid-template-columns: repeat(2, minmax(16em, 30em));
        max-width: 900px;
        justify-self: center;
      }
    }
    .info-card {
      /* grid-column: 2; */
    }
    main {
      grid-template-columns: 1fr auto 1fr;
      padding: 2rem 2rem var(--groundHeight) 2rem;
    }

    .time-cards-list {
      display: grid;
      grid-template-columns: subgrid;
      grid-column: 1 / -1;
      justify-items: center;
      gap: 2rem;
      padding: 0;
    }
    .hero {
      display: grid;
      height: calc(var(--contentAreaHeight) - (8rem + 100px));
      grid-column: 1 / -1;
      gap: 2rem;
      align-items: start;
      @media (min-width: 750px) {
        grid-template-columns: 1fr 260px;
      }
      @media (min-width: 900px) {
        grid-template-columns: 1fr 360px;
      }
      @media (min-width: 1200px) {
        padding: 0 2rem;
      }
      & :where(h1, h2, h3, h4, h5, h6) {
        margin: 0;
      }
      .hero-headline {
        grid-column: 1;
        font-size: 4rem;
        line-height: 1;
        align-self: end;
        max-width: 12ch;
        border-bottom: var(--borderDottedLight);
        padding-block-end: 2rem;
        & span {
          display: inline-block;
        }
        @media (min-width: 750px) {
          border-bottom: none;
          padding-block-end: 0;
        }
        @media (min-height: 800px) {
          font-size: 5rem;
        }

        @media (min-width: 900px) and (min-height: 700px) {
          font-size: 5rem;
        }
        @media (min-width: 1280px) and (min-height: 900px) {
          font-size: 6rem;
        }
      }

      .details {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        grid-column: 1 / -1;

        @media (min-width: 750px) {
          grid-column: 2;
          text-align: right;
          justify-content: end;
          align-self: end;
        }
        .details-btns {
          display: flex;
          flex-wrap: wrap;
          justify-content: end;
          gap: 1rem;
        }
        & * {
          font-family: var(--sans);
        }
        & h3 {
          font-size: 1.5rem;
          font-weight: 700;
          color: var(--brightblue);
        }
        & p {
          font-size: 1rem;
          font-weight: 500;
          color: var(--brightblueAlpha20);
          margin: 0;
        }
      }
      & a {
        align-self: center;
      }
    }

    .date {
      text-align: center;
      & h2,
      h3,
      h4,
      h5 {
        font-family: "Source Sans 3";
      }
    }
  </style>
</Layout>
