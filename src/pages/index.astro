---
import Layout from "../layouts/Layout.astro";
import Logo from "../components/Logo.astro";
import BackgroundScene from "../components/BackgroundScene.astro";
import TimeCard from "../components/TimeCard.astro";
import Nav from "../components/Nav.astro";

const timeCardData = [
  {
    title: "Brezeln",
    body: "Enjoy food stalls, rides and entertainment on Cunningham Pier",
    def: "(noun) Pretzel",
    href: "#map",
    time: "10am",
  },
  {
    title: "Frühschoppen",
    body: "From Amber Ale to Weizenbock, you will find a huge variety of beer in the 3 Bierhalles.",
    def: "(noun) /ˈfryːʃɔpən/ Morning drink",
    href: "#map",
    time: "12pm",
  },
  {
    title: "Schuhplattler",
    body: "Live performances on the main stage, featuring traditional folk dancing and music.",
    def: "(noun)  ˈshüˌplätlə(r) a Bavarian courtship dance",
    href: "#map",
    time: "3pm",
  },
  {
    title: "Abendessen",
    body: "Explore food stalls along the waterfront, or sit for a traditional Oktoberfest meal at one of the 3 Bierhalles.",
    def: "(noun) /ˈaːbənt|ɛsən/ Evening meal",
    href: "#map",
    time: "7pm",
  },
];
console.log(timeCardData);
---

<script src="../lib/timelines.ts"></script>

<Layout title="Oktoberfest Geelong">
  <header>
    <div class="logo">
      <a href="/" title="Oktoberfest Geelong Homepage">
        <Logo />
      </a>
    </div>
    <Nav />
  </header>

  <main id="main">
    <div class="content-area">
      <section class="content hero">
        <h2 class="hero-headline">
          <span>Beer,</span>
          <span>Bratwurst,</span>
          <span>Beach.</span>
        </h2>
        <div class="details">
          <a class="btn tickets" href="#">Get tickets</a>
          <span>
            <h3>Saturday October 4</h3>
            <h4>Cunningham Pier, Geelong Waterfront</h4>
          </span>
        </div>
      </section>

      <div class="content time-cards-wrapper" id="whats-on">
        <h3 class="content-heading scroll-trigger">What's on</h3>

        {
          timeCardData.map((card) => (
            <TimeCard
              title={card.title}
              body={card.body}
              def={card.def}
              href={card.href}
              time={card.time}
            />
          ))
        }
      </div>
    </div>
    <BackgroundScene />
  </main>

  <script>
    // Setting scrollRestoration to manual to avoid scrollTrigger weirdness
    window.history.scrollRestoration = "manual";
  </script>
  <style is:global>
    :root {
      --groundHeight: 220px;
      --contentAreaHeight: calc(100vh - var(--groundHeight));
    }
    @media (min-width: 750px) and (min-height: 700px) {
      :root {
        --groundHeight: 250px;
      }
    }
    @media (min-width: 900px) and (min-height: 900px) {
      :root {
        --groundHeight: 300px;
      }
    }
    main {
      padding: 2rem 2rem var(--groundHeight) 2rem;
      position: relative;
      z-index: 11;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }
    .content-area {
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: auto;
      z-index: 30;
    }
    header {
      position: relative;
      display: grid;
      grid-template-columns: auto 16rem;
      justify-items: start;
      z-index: 12;
      width: 100%;
      @media (min-width: 750px) {
        grid-template-columns: min-content 1fr;
        position: relative;
      }
    }
    .logo {
      grid-row: 1;
      grid-column: 1;
      width: 180px;
      margin: 0 2rem 0 2rem;
      @media (min-width: 750px) {
        width: 220px;
      }
    }

    .content {
      position: relative;
      display: grid;
      grid-template-columns: subgrid;
      gap: 2rem;
      z-index: 11;
      color: var(--brightblue);

      & h2 {
        font-size: 3rem;
        line-height: 1.125;
        /* margin: 0; */
        color: var(--brightblue);
      }
      & h3 {
        font-weight: 700;
        line-height: 1.25;
        /* margin: 0; */
        font-size: 2rem;
        /* color: var(--brightblue); */
      }
      & h4,
      h5 {
        font-family: "Source Sans 3";
        font-weight: 500;
        font-size: 1.25rem;
        line-height: 1.33;
        /* margin: 0; */
      }
      @media (min-width: 600px) {
        & h2 {
          font-size: 3.5rem;
        }
        & h3 {
          font-size: 2.5rem;
        }
      }

      &:last-child {
        margin-bottom: var(--groundHeight);
      }
    }
    .content .content-heading {
      font-size: 1.5rem;
      font-family: var(--sans);
      opacity: 0;
      transition: opacity 0.25s ease-in;
      position: fixed;
      inset: 0 auto auto auto;
      text-align: left;
      margin-bottom: 2rem;
      grid-column: 1 / -1;
      padding: 1rem;
      /* border-bottom: 2px dotted rgba(255, 255, 255, 0.33); */
      /* border-top: 2px dotted rgba(255, 255, 255, 0.33); */
      &.active {
        opacity: 1;
      }
    }
    .time-cards-wrapper {
      z-index: 10;
      display: grid;
      grid-template-columns: subgrid;
      grid-column: 1 / -1;
      justify-items: center;
    }

    .hero.content {
      height: calc(var(--contentAreaHeight) - (8rem + 120px));
      grid-template-columns: min-content 1fr;
      grid-template-rows: auto;
      grid-column: 1 / -1;
      gap: 2rem;
      align-items: start;
      @media (min-width: 750px) {
        grid-template-columns: min-content 1fr 260px;
      }
      @media (min-width: 900px) {
        padding: 0 2rem;
        grid-template-columns: min-content 1fr 300px;
      }
      & :where(h1, h2, h3, h4, h5, h6) {
        margin: 0;
      }
      & h2 {
        grid-column: 1;
        grid-row: 1;
        font-size: 4rem;
        line-height: 1.1;
        align-self: end;
        & span {
          display: inline-block;
        }
        @media (min-width: 900px) and (min-height: 700px) {
          font-size: 5rem;
          line-height: 1;
        }
        @media (min-width: 1280px) and (min-height: 900px) {
          font-size: 6rem;
        }
      }

      .details {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        grid-column: 1 / -1;
        grid-row: 2;
        /* text-shadow: 0em 0em 0.5em rgba(255, 255, 255, 0.25); */
        @media (min-width: 750px) {
          grid-column: 3;
          grid-row: 1;
          text-align: right;
          justify-content: end;
          align-self: end;
          gap: 2rem;
        }
        & h3 {
          font-family: "Source Sans 3";
          font-size: 1.25rem;
          font-weight: 600;
          font-family: var(--);
        }
        & h4 {
          font-size: 1rem;
          font-weight: 400;
        }
      }
      & a {
        align-self: center;
      }
    }

    .date {
      text-align: center;
      & h2,
      h3,
      h4,
      h5 {
        font-family: "Source Sans 3";
      }
    }
  </style>
</Layout>
