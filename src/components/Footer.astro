---
import Logo from "./Logo.astro";
---

<footer transition:name="footer" transition:animate="initial">
  <div class="logo">
    <Logo />
  </div>
</footer>

<style>
  footer {
    margin-block-end: var(--groundHeight);
  }
  .logo {
    grid-row: 3;
    grid-column: 1;
    width: 160px;
    margin: 0 1rem 1rem 2rem;
    @media (min-width: 1200px) {
      width: 200px;
    }
  }
</style>
