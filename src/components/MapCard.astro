---
import { Icon } from "astro-icon/components";
interface Props {
  name: string;
  id: string;
  type: string;
  gmaps: string;
  content: string;
  location: string;
}

const { name, id, type, gmaps, content, location } = Astro.props;
---

<div
  class="card map-card"
  id={id}
  data-name={name}
  data-group={type}
  aria-current="false"
>
  <span>
    <h3>{name}</h3>
    <!-- <span class="location">{location}</span> -->
  </span>
  <p>{content}</p>
  <a
    class="btn btn--xs btn--blue btn--outline"
    title="Open in Maps"
    href={gmaps}
    target="_blank"
  >
    <Icon name="icon-map" />
    Google Maps
  </a>
</div>

<style>
  .map-card {
    grid-template-columns: minmax(min-content, 10em) 1fr;
    grid-template-rows: min-content;
    align-content: start;
    border: none;
    padding: 2rem;
  }
  h3 {
    margin: 0;
    font-family: var(--sans);
    font-weight: 600;
  }
  span {
    grid-row: 1;
    grid-column: 1;
  }
  a {
    font-size: 0.75rem;
    grid-row: 2;
  }
  p {
    font-size: 0.875rem;
    margin: 0;
    grid-row: 1;
    grid-column: 2;
  }
  @media (min-width: 900px) {
    .map-card {
      grid-template-columns: 1fr;
      grid-template-rows: min-content;
    }
    p {
      grid-column: 1;
      grid-row: 2;
      font-size: 1rem;
    }
    h3 {
      font-size: 1.5rem;
      line-height: 1.3;
    }
    a {
      grid-column: auto;
      grid-row: auto;
    }
  }
  @media (min-width: 1100px) {
    p {
      font-size: 1rem;
    }
    h3 {
      font-size: 1.5rem;
    }
  }
  @media (min-width: 1400px) {
    p {
      font-size: 1.25rem;
    }
    h3 {
      font-size: 1.75rem;
    }
  }
  @media (min-width: 1600px) {
    /* h3 {
      font-size: 2rem;
    } */
  }
</style>
