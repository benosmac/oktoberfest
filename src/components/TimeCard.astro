---
interface Props {
  title: string;
  body: string;
  def: string;
  href: string;
  time: string;
}

const { href, title, body, time, def } = Astro.props;
---

<li class="card time-card" data-scrolltrigger="card" data-time={time}>
  <h2>{time}</h2>
  <span class="title">
    <h3>{title}</h3>
    <span class="define">{def}</span>
  </span>
  <div>
    <a class="btn btn--small icon-map" href={href} title="View location on map"
      >Details</a
    >
    <p>
      {body}
    </p>
  </div>
</li>
<style>
  .time-card {
    display: grid;
    grid-template-columns: min-content minmax(min-content, 18em);
    grid-column: 2 / 3;
    gap: 2rem;
    align-content: center;
    padding: 3rem 2rem 3rem 2rem;
    border: var(--borderLight);
    border-radius: 0.5em;

    & * {
      transition: color 0.5s var(--defaultTimingIn);
    }
    & :where(h1, h2, h3, h4, h5, h6) {
      margin: 0;
    }
    & > * {
      grid-column: 1 / 3;
    }
    & div {
      display: grid;
      grid-template-columns: subgrid;
      border-top: var(--borderDottedLight);
      padding-top: 2rem;
    }
    & h4,
    h5 {
      font-family: var(--sans);
      font-weight: 500;
      font-size: 1.25rem;
      line-height: 1.33;
      /* margin: 0; */
    }
    & h2 {
      font-size: 3rem;
      line-height: 1.125;
      grid-column: 1;
      grid-row: 1;
      align-self: center;
      color: var(--red);
    }
    & h3 {
      font-weight: 700;
      line-height: 1.25;
      font-size: 2rem;
      padding-bottom: 0;
      color: var(--brightblue);
    }
    .title {
      grid-column: 2;
      grid-row: 2 / -1;
      text-wrap: pretty;
    }
    & p {
      margin: 0;
      grid-column: 2;
      grid-row: 3;
      color: var(--bodyTextColour);
      padding: 0;
    }
    .define {
      font-size: 0.875rem;
      font-style: italic;
      color: var(--brightblue);
    }
    .btn {
      color: var(--brightblue);
      border-color: var(--brightblue);
      grid-column: 1;
      grid-row: 3;
      align-self: center;
      transition:
        color 0.5s var(--defaultTimingIn),
        border-color 0.5s var(--defaultTimingIn);
    }
  }
</style>
