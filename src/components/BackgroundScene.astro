---
import ShoreleftSVG from "../components/ShoreLeftSVG.astro";
import CloudsSVG from "../components/CloudsSVG.astro";
import BirdSVG from "../components/BirdSVG.astro";
import BoatSVG from "./BoatSVG.astro";
import WavesSVG from "./WavesSVG.astro";

interface Props {}

const {} = Astro.props;
---

<div class="bg" aria-hidden="true">
  <div class="gradient-overlay"></div>
  <div class="sky">
    <div class="clouds">
      <CloudsSVG />
    </div>
    <div class="bird">
      <BirdSVG />
    </div>
  </div>
</div>
<div class="fg" aria-hidden="true">
  <div class="ground">
    <div class="texture-overlay"></div>
    <img src="statues-shadows.svg" class="statues-shadows" />
    <img src="statues.svg" class="statues" />
    <div class="water">
      <WavesSVG />
    </div>
    <img src="jetty.svg" class="jetty" />
    <div class="boat">
      <BoatSVG />
    </div>
    <div class="shore-l">
      <ShoreleftSVG />
    </div>
    <div class="sand"></div>
  </div>
  <div class="sand sand-fill"></div>
</div>

<style is:global>
  .bg,
  .fg {
    position: fixed;
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
    background-blend-mode: overlay;
    transition: filter 0.5s var(--defaultTimingIn);
    will-change: filter;
    overflow-x: clip;
  }
  .fg {
    inset: calc(calc((100vh - var(--groundHeight)) - 2rem)) 0 0 0;
    grid-template-rows: var(--groundHeight) 2rem 100vh;
    z-index: 30;
  }
  .bg {
    height: 100lvh;
    inset: 0;
    grid-template-rows: 1fr var(--groundHeight);
    z-index: 5;
    background: var(--sky) url(/texture.png);
  }
  .texture-overlay {
    position: absolute;
    inset: 0;
    background: url(/texture.png);
    height: 100%;
    z-index: 10;
  }
  .sky {
    grid-column: 1 / 1;
    grid-row: 1;
    display: grid;
    grid-template-columns: 1fr 350px 1fr;
    grid-template-rows: min-content min-content 1fr;
    justify-items: center;
  }
  .clouds {
    grid-column: 1 / -1;
    grid-row: 3;
    align-self: center;
    width: 110%;
    padding: 2rem;
    z-index: 11;
    mix-blend-mode: overlay;
    will-change: transform, filter;
    transition:
      filter 1s var(--defaultTimingIn),
      transform 3s var(--defaultTimingIn);
  }
  .bird {
    grid-column: 1;
    grid-row: 3;
    width: 20px;
    align-self: center;
    justify-self: start;
    z-index: 11;
  }
  .ground {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
    display: grid;
    grid-template-rows: 15% 35% 50%;
    grid-template-columns: 1fr auto 1fr;
    will-change: transform;
  }
  .water {
    grid-column: 1 / -1;
    grid-row: 2 / 4;
    background: var(--water) url(/texture-2.png);
    background-blend-mode: soft-light;
  }
  .boat {
    width: 40px;
    margin-top: -20px;
    grid-column: 3;
    grid-row: 2;
    align-self: start;
    justify-self: center;
    z-index: 5;
  }

  .sand {
    /* position: relative; */
    background: var(--sand) url(/texture-2.png);
    background-blend-mode: overlay;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    grid-column: 1 / -1;
    grid-row: 3 / 4;
  }
  .sand-fill {
    grid-row: 3 / -1;
  }
  .statues,
  .statues-shadows {
    grid-column: 2;
    grid-row: 1 / span all;
    align-self: center;
    min-width: var(--groundHeight);
    z-index: 11;
    margin-bottom: 2rem;
    will-change: transform;
  }
  .statues {
  }
  .statues-shadows {
    opacity: 0.2;
    transform: skewX(90deg) scaleY(0.4);
    transform-origin: bottom center;
    transition:
      filter 1s var(--defaultTimingIn),
      opacity 1s var(--defaultTimingIn);
  }
  .shore-l {
    grid-row: 1 / 3;
    grid-column: 1 / -1;
    height: 101%;
    z-index: 5;
  }
  .jetty {
    grid-row: 1 / 3;
    grid-column: 2 / -1;
    align-self: end;
    justify-self: end;
    max-width: 200px;
    margin: 0 -20% 1rem 0;
    z-index: 10;
  }

  @media (min-width: 700px) and (min-height: 700px) {
    .statues,
    .statues-shadows {
      /* min-width: var(--groundHeight); */
    }
    .jetty {
      max-width: 240px;
      margin: 0 0 1rem 0;
    }
  }
  .gradient-overlay {
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    background-image: linear-gradient(
      180deg in oklab,
      oklch(19.84% 0.0911 281.68) 10% 10%,
      oklch(49% 0.1 232) 50%,
      oklch(81% 0.31 39) 85% 85%
    );
    background-blend-mode: overlay;
    opacity: 0;
    height: 100%;
    transition: opacity 1s var(--defaultTimingIn);
    will-change: opacity;
  }
  @keyframes flash {
    50% {
      fill: #ff90d9;
    }
  }
  .dusk,
  .night,
  .late-night {
    --contentHeadingTextColour: var(--offWhite);
    --borderDottedLight: 3px dotted oklab(var(--offWhiteLAB) / 0.33);
    .lines > rect {
      animation: flash 2s var(--defaultTimingIn) infinite;
      transition: fill 0.5s var(--defaultTimingIn);
      &:nth-child(odd) {
        fill: #ffbc4a;
        animation-delay: 1s;
      }
      &:nth-child(even) {
        fill: #4edeff;
      }
    }
  }

  .dusk {
    --brightblue: var(--brightblueShade20);
    --red: var(--redShade20);
    --borderLight: 3px solid oklab(var(--offWhiteLAB) / 0.25);

    .fg {
      /* filter: brightness(0.8) contrast(1); */
      filter: brightness(0.8);
    }
    .bg {
      /* filter: brightness(0.9) contrast(1.2); */
      filter: brightness(0.9);
    }
    .gradient-overlay {
      opacity: 0.3;
    }
    .clouds {
      filter: blur(px);
      /* transform: scale(1.1); */
    }
  }
  .night,
  .late-night {
    --bodyTextColour: var(--offWhite);
    --brightblue: var(--brightblueTint50);
    --red: var(--redTint30);
    --borderLight: 3px solid oklab(var(--offWhiteLAB) / 0.125);
  }
  .night {
    .fg {
      filter: brightness(0.65) contrast(1.2);
      /* filter: brightness(0.65); */
    }
    .bg {
      /* filter: brightness(0.6) contrast(1.3); */
      filter: brightness(0.6);
    }
    .clouds {
      filter: blur(2px);
      /* transform: scale(1.2); */
    }
    .statues-shadows {
      filter: blur(2px);
    }
    .gradient-overlay {
      opacity: 0.7;
    }
  }

  .late-night {
    .fg {
      /* filter: brightness(0.55) contrast(1.3); */
      filter: brightness(0.55) contrast(1.2);
    }
    .bg {
      /* filter: brightness(0.5) contrast(1.3); */
      filter: brightness(0.5);
    }
    .clouds {
      filter: blur(4px);
      /* transform: scale(1.3); */
    }
    .statues-shadows {
      filter: blur(12px);
      opacity: 0.1;
    }
    .gradient-overlay {
      opacity: 0.7;
    }
  }
</style>
