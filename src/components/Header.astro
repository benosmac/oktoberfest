---
import Nav from "./Nav.astro";
import Logo from "./Logo.astro";
import { logoTimeline } from "../lib/timelines";
---

<header transition:name="header" transition:animate="initial">
  <div class="logo">
    <a href="/" title="Oktoberfest Geelong Homepage">
      <Logo />
    </a>
  </div>
  <Nav />
</header>

<style>
  header {
    position: relative;
    display: grid;
    grid-template-columns: auto 16rem;
    justify-items: start;
    z-index: 12;
    width: 100%;
    @media (min-width: 750px) {
      grid-template-columns: min-content 1fr;
      position: relative;
    }
  }
  .logo {
    grid-row: 1;
    grid-column: 1;
    width: 160px;
    margin: 0 1rem 1rem 2rem;
    @media (min-width: 1200px) {
      width: 200px;
    }
  }
</style>
