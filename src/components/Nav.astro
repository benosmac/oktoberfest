---

---

<button
  id="nav-toggle"
  title="Open Menu"
  aria-label="Open Menu"
  aria-expanded="false"
  aria-controls="nav"
  aria-haspopup="true"
  class="nav-toggle"
  data-target="#nav"
>
  <svg
    viewBox="0 0 24 24"
    aria-hidden="true"
    class="astro-dmqpwcec"
    width="48"
    height="48"
    ><path fill="#fff" d="M3 6h18v2H3V6m0 5h18v2H3v-2m0 5h18v2H3v-2z"
    ></path></svg
  >
</button>
<nav id="nav" transition:name="nav">
  <ul>
    <li><a href="/#things-to-do">Things to do</a></li>
    <li><a href="/#info">Info</a></li>
    <li><a href="/map">Map</a></li>
    <li><a href="/tickets">Tickets</a></li>
  </ul>
</nav>

<script>
  import { scrollTargetToCenter } from "../lib/modules";
  let navLinks = document.querySelectorAll("#nav a");
  let navToggle = document.querySelector<HTMLLinkElement>("#nav-toggle");
  let contentArea = document.querySelectorAll(".content-area")[0];

  document.addEventListener("astro:page-load", () => {
    navToggle = document.querySelector<HTMLLinkElement>("#nav-toggle");
    navLinks = document.querySelectorAll("#nav a");
    contentArea = document.querySelectorAll(".content-area")[0];

    navToggle?.addEventListener("click", toggleNav);
    setupNav();
  });

  function setupNav() {
    // Make nav items unfocusable when offscreen
    if (window.matchMedia("(max-width: 749px)").matches) {
      navLinks.forEach((link) => {
        link.setAttribute("tabindex", "-1");
      });
    }
    // Scroll # anchors to center of first child element (ensure gsap transition doesn't hide first item in section)
    //TODO: Not needs refactoring to work on any page
    navLinks.forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) {
        return;
      }
      const url = new URL(link.href);

      if (url.hash && url.pathname === location.pathname) {
        link.addEventListener("click", (event) => {
          event.preventDefault();
          toggleNav();
          scrollTargetToCenter(url);
        });
      }
    });
  }
  function toggleNav() {
    // Nav is open
    if (document.body.dataset.navOpen == "true") {
      //close it
      document.body.dataset.navOpen = "false";
      navLinks.forEach((link, index) => {
        link.setAttribute("tabindex", "-1");
      });
      navToggle?.setAttribute("aria-expanded", "false");
      contentArea?.removeAttribute("inert");
    }
    // Nav is closed
    else {
      //open it
      document.body.dataset.navOpen = "true";
      navLinks.forEach((link) => {
        link.setAttribute("tabindex", "0");
      });
      navToggle?.focus();
      navToggle?.setAttribute("aria-expanded", "true");
    }
  }
</script>
<style is:global>
  #nav-toggle {
    display: none;
    @media (max-width: 749px) {
      display: flex;
      inset: 0 0 auto auto;
      position: fixed;
      background: none;
      border: none;
      z-index: 5;
      padding: 1rem;

      & svg path {
        fill: var(--brightblue);
        transition: fill 0.5s var(--defaultTimingIn);
      }
    }
  }
  main > *:not([aria-hidden="true"]) {
    transition:
      transform 0.25s var(--defaultTimingIn),
      opacity 0.24s var(--defaultTimingIn);
  }
  body[data-nav-open="true"] {
    @media (max-width: 749px) {
      & nav {
        transform: translateX(0);
      }
      & #nav-toggle {
        position: fixed;
        justify-content: end;
        inset: 0;
        width: 100%;
        height: 100%;
      }
      & main > *:not([aria-hidden="true"]) {
        opacity: 0;
      }
    }
  }
  nav {
    display: grid;
    grid-row: 1;
    grid-column: 2;
    width: 100%;

    & ul {
      margin: 1rem 0 0 0;
      padding: 1rem 2rem 0 0;
      font-size: 1.25rem;
      display: flex;
      flex-wrap: wrap;
      list-style: none;
      & li {
        & a {
          text-decoration: none;
          color: var(--brightblue);
          font-weight: 700;
          padding: 0.5rem;
        }
      }
    }
    @media (max-width: 749px) {
      position: fixed;
      width: 16rem;
      inset: 4rem 0 auto auto;
      height: var(--contentAreaHeight);
      align-items: center;
      transform: translateX(16rem);
      transition: transform 0.25s var(--defaultTimingIn);
      z-index: 10;
      & ul {
        align-items: end;
        flex-direction: column;
        gap: 1.5rem;
        font-size: 2rem;
      }
    }
    @media (min-width: 750px) {
      & ul {
        justify-content: end;
        gap: 1rem;
      }
    }
  }
</style>
